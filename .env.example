REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=orange_market_simple
MYSQL_USERNAME=root
MYSQL_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 本地开发请把 CALLBACK_URL 留空：OSS 无法访问局域网，直传成功后由前端接口入库
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_STS_ROLE_ARN=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-hangzhou
ALIYUN_OSS_HOST=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_CALLBACK_URL=
ALIYUN_OSS_EXPIRE_SECONDS=3600

# 支付宝开放平台（密钥模式 RSA2 + AES 内容加密）。私钥不要提交到 git。
# 正式环境需要商家认证。没有营业执照时改用沙箱，把下面几项换成沙箱应用里的值：
#   ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
#   ALIPAY_APP_ID / 应用私钥 / 支付宝公钥 / AES 都用沙箱应用的，不能用正式应用的密钥
# 支付页可选当面扫码（qr）或手机网站支付（wap）。沙箱扫码需沙箱版支付宝；手机网站支付用沙箱买家账号在浏览器付款。
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_MERCHANT_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_ENCRYPT_KEY=
ALIPAY_NOTIFY_URL=http://127.0.0.1:8080/api/payments/alipay/notify
ALIPAY_TRADE_MODE=
ALIPAY_RETURN_BASE_URL=http://127.0.0.1:5173
ALIPAY_ALLOW_MOCK=true
